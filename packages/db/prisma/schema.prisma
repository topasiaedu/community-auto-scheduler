generator client {
  provider = "prisma-client-js"
}

// Run: `npm run db:seed` from repo root (after migrate).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageType {
  POST
  POLL
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DRAFT
  CANCELLED
}

enum OperatorKind {
  REMINDER
  VALUE
}

enum ValueFormat {
  IMAGE_CAPTION
  TEXT_ONLY
  POLL
}

enum ReminderFormat {
  IMAGE
  TEXT
  STICKER
}

enum ScheduleRuleKind {
  WEBINAR_DATE_OFFSET
  EVENT_START_OFFSET
}

model Project {
  id                String                  @id @default(cuid())
  name              String
  description       String?
  sopUrl                String?
  campaignNote          String?
  /// WhatsApp community JIDs for Value fan-out; null or [] = all eligible communities.
  activeCommunityJids   Json?
  createdAt             DateTime                @default(now())
  messages          ScheduledMessage[]
  notifyRecipients  NotifyRecipient[]
  members           ProjectMember[]
  userPreferences   UserProjectPreference[]
  campaigns         Campaign[]
  reminderTemplates ReminderTemplate[]
}

// Links a Supabase Auth user id to a Project (see API X-Project-Id membership checks).
model ProjectMember {
  id        String   @id @default(cuid())
  // Supabase Auth user id (JWT `sub` / session `user.id`).
  userId    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
}

model NotifyRecipient {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  waNumber  String
  label     String?

  @@index([projectId])
}

model Campaign {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  webinarDate       DateTime           @db.Date
  eventStartTimeMyt String
  reminderGroupJid  String
  reminderGroupName String
  customValues      Json
  createdAt         DateTime           @default(now())
  messages          ScheduledMessage[]
  reminderBoard     CampaignReminderBoard?

  @@index([projectId])
}

/// One Telegram status message per campaign. Lines are append-only; the formatter decides which mark to show.
model CampaignReminderBoard {
  campaignId String   @id
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chatId     String
  /// Telegram message_id of the board in that chat. Null until the first send is stored.
  messageId  Int?
  lines      Json
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ReminderTemplate {
  id                 String             @id @default(cuid())
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slotKey            String
  name               String
  reminderFormat     ReminderFormat
  mediaUrl           String?
  stickerUrl         String?
  bodyTemplate       String?
  /// When false, slot is omitted from campaign scheduling (per-project rhythm).
  enabled            Boolean            @default(true)
  scheduleRuleKind   ScheduleRuleKind
  dayOffset          Int?
  clockTimeMyt       String?
  startOffsetMinutes Int?
  sortOrder          Int
  scheduledMessages  ScheduledMessage[]

  @@unique([projectId, slotKey])
  @@index([projectId])
}

model ScheduledMessage {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groupJid           String
  groupName          String
  type               MessageType
  operatorKind       OperatorKind?
  valueFormat        ValueFormat?
  reminderFormat     ReminderFormat?
  reminderTemplateId String?
  reminderTemplate   ReminderTemplate? @relation(fields: [reminderTemplateId], references: [id], onDelete: SetNull)
  campaignId         String?
  campaign           Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  copyText           String?
  imageUrl           String?
  stickerUrl         String?
  pollQuestion       String?
  pollOptions        String[]          @default([])
  pollMultiSelect    Boolean           @default(false)
  scheduledAt        DateTime
  status             MessageStatus     @default(PENDING)
  sentAt             DateTime?
  error              String?
  createdAt          DateTime          @default(now())
  /// pg-boss job id for cancel/reschedule; null for DRAFT rows not yet queued or legacy rows.
  pgBossJobId        String?
  /// Supabase Auth `user.id` of who created the schedule.
  createdByUserId    String?
  /// WhatsApp stanza id from SendResponse after IPC accept (Agent 2 / engagement tracker).
  waMessageId        String?
  /// When the send IPC returned an id (still SENDING until server receipt).
  waAcceptedAt       DateTime?
  /// When message:receipt matched waMessageId (status becomes SENT).
  waAckedAt          DateTime?
  /// Groups rows that belong to one scheduled post (one fan-out, or one single row).
  fanOutBatchId      String?
  reactions          MessageReaction[]
  replies            MessageReply[]

  @@index([projectId, scheduledAt])
  @@index([campaignId])
  @@index([waMessageId])
  @@index([fanOutBatchId])
}

/// One handled fan-out batch. `postedAt` stays null until the sweep finishes it.
/// A Community Reminder batch waits for the Telegram board. Other batches are closed with no WhatsApp DM.
model PostStatusNotice {
  id        String    @id @default(cuid())
  batchId   String    @unique
  postedAt  DateTime?
  body      String    @default("")
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// One emoji reaction per reactor on a tracked NMCAS outbound message (Agent 4).
/// Empty `emoji` means the reactor removed their reaction (row kept for upsert history).
model MessageReaction {
  id                 String           @id @default(cuid())
  scheduledMessageId String
  scheduledMessage   ScheduledMessage @relation(fields: [scheduledMessageId], references: [id], onDelete: Cascade)
  /// WhatsApp JID of the member who reacted.
  reactorJid         String
  /// Emoji text; empty string = reaction removed.
  emoji              String
  /// Stanza id of the reaction message itself (when known).
  waReactionId       String?
  /// Display name from the reaction event, when WhatsApp sent one.
  reactorName        String?
  reactedAt          DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([scheduledMessageId, reactorJid])
  @@index([scheduledMessageId])
}

/// A reply that targets a tracked NMCAS message.
/// Announcement comments (`targetMessageKey`) and normal-group quotes (`stanzaID`).
model MessageReply {
  id                 String           @id @default(cuid())
  scheduledMessageId String
  scheduledMessage   ScheduledMessage @relation(fields: [scheduledMessageId], references: [id], onDelete: Cascade)
  /// WhatsApp stanza id of the reply message (unique per parent for upsert).
  replyWaMessageId   String
  /// WhatsApp JID of the member who replied.
  replierJid         String
  /// Display name from the reply event, when WhatsApp sent one.
  replierName        String?
  /// Truncated body preview for operators (not full analytics).
  bodyPreview        String?
  repliedAt          DateTime
  createdAt          DateTime         @default(now())

  @@unique([scheduledMessageId, replyWaMessageId])
  @@index([scheduledMessageId])
}

/// Per-user UI preferences for a project (e.g. last selected WhatsApp group).
model UserProjectPreference {
  id            String   @id @default(cuid())
  userId        String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastGroupJid  String?
  lastGroupName String?
  updatedAt     DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
}

/// Per-project whatsmeow SQLite session (bytea). whatsmeow runs against a local file; we
/// hydrate/persist this row so sessions survive deploys without direct Postgres / search_path.
model WhatsAppSessionBlob {
  projectId String   @id
  data      Bytes
  updatedAt DateTime @updatedAt
}
