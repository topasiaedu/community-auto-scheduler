# Supabase Postgres — session pooler (port 5432) for Prisma + pg-boss.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: local SQLite dir for whatsmeow. Sessions are also saved to Postgres
# (WhatsAppSessionBlob) via DATABASE_URL — no direct Postgres / WHATSAPP_STORE_URL needed on Render.
# WHATSAPP_STORE_URL=file:./data/wa-sessions

# API
PORT=3001
# Comma-separated browser origins allowed by the API (CORS). Add http://localhost:5174 if you ever run Vite on another port.
WEB_ORIGIN=http://localhost:5173

# Used with Supabase Auth JWT verification on the API
SUPABASE_URL=https://YOUR_REF.supabase.co
# Settings → API → Project API keys → `anon` `public` (API uses this for `auth.getUser(jwt)` only).
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# P0 spike only — Baileys session bucket (API no longer uses this; spike unchanged)
# NMCAS_SESSION_BUCKET=nmcas-sessions
NMCAS_PROJECT_ID=p0-local-test

# Default Prisma project id (seed with `npm run db:seed`; must match seed)
DEFAULT_PROJECT_ID=nmcas-default-project

# Private bucket for scheduled post images (separate object prefix from sessions/)
NMCAS_POST_MEDIA_BUCKET=nmcas-post-media

# Worker + daily digest: WhatsApp DMs to these MSISDNs (comma-separated; +/dashes optional).
# Defaults always include 60139968817 and 60176782206 even if this is unset or still a single number.
# NMCAS_FAILURE_NOTIFY_MSISDN=60139968817,60176782206

# Telegram group alert when a warm WhatsApp session stays disconnected.
# Token from @BotFather. Chat id is the negative group id. Leave both empty to disable.
# Setup steps: NMCAS-VAULT/wiki/analysis/telegram-wa-disconnect-alert.md
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NMCAS_TELEGRAM_WA_ALERT_ENABLED=true
# NMCAS_WA_DOWN_GRACE_MS=180000

# Vite web app (same Supabase project). Copy into apps/web/.env if you do not load them from the repo root.
# VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=
